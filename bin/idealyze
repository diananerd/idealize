#!/usr/bin/env bash
# idealyze — Terminal IDE companion for AI coding agents
# https://github.com/diananerd/idealize

set -euo pipefail

VERSION="0.3.0"
IDEALYZE_HOME="${HOME}/.idealyze"
SESSION_FILE="${IDEALYZE_HOME}/session.json"
DEBUG_LOG="${IDEALYZE_HOME}/debug.log"

# Debug helper — set IDEALYZE_DEBUG=1 to enable logging to ~/.idealyze/debug.log
debug() {
    [[ "${IDEALYZE_DEBUG:-}" == "1" ]] && mkdir -p "$IDEALYZE_HOME" && echo "[main  $(date +%H:%M:%S)] $*" >> "$DEBUG_LOG" || true
}

# Resolve lib directory (works both from repo and installed)
if [[ -d "${IDEALYZE_HOME}/lib" ]]; then
    LIB_DIR="${IDEALYZE_HOME}/lib"
else
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    LIB_DIR="${SCRIPT_DIR}/../lib"
fi

# Resolve config directory
if [[ -d "${IDEALYZE_HOME}/config" ]]; then
    CONFIG_DIR="${IDEALYZE_HOME}/config"
else
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    CONFIG_DIR="${SCRIPT_DIR}/../config"
fi

# Load configuration
source "${LIB_DIR}/config.sh"
config_load

usage() {
    cat <<'EOF'
idealyze — Terminal IDE companion for AI coding agents

Usage:
    idealyze                       Launch IDE layout (tree + viewer)
    idealyze --with-agent          Launch with agent pane (default: claude)
    idealyze --with-agent CMD      Launch with custom agent command
    idealyze --global              Capture events from all projects
    idealyze toggle tree           Collapse/restore file tree sidebar
    idealyze toggle agent          Add/remove the agent pane
    idealyze toggle render         Switch between raw and rendered viewer
    idealyze doctor                Diagnose and fix dependencies
    idealyze update                Update to latest version from install channel
    idealyze stop                  Close session and Ghostty window
    idealyze uninstall             Remove idealyze completely
    idealyze --version             Show version
    idealyze --help                Show this help

Environment:
    IDEALYZE_DEBUG=1               Enable verbose logging to ~/.idealyze/debug.log
    IDEALYZE_AGENT_CMD=<cmd>       Override agent command (default: claude)

Requirements: macOS, Ghostty 1.3+, broot, bat, jq
Optional: glow (markdown preview)
EOF
}

# --- Ghostty config helpers ---

ghostty_config_set() {
    local key="$1" value="$2"
    local conf="${HOME}/.config/ghostty/config"
    mkdir -p "$(dirname "$conf")"
    if [[ -f "$conf" ]] && grep -q "^${key}" "$conf"; then
        sed -i '' "s/^${key}.*/${key} = ${value}/" "$conf"
    else
        echo "${key} = ${value}" >> "$conf"
    fi
}

ghostty_config_remove() {
    local key="$1"
    local conf="${HOME}/.config/ghostty/config"
    [[ -f "$conf" ]] || return 0
    sed -i '' "/^${key}/d" "$conf"
    # Remove file if empty
    [[ -s "$conf" ]] || rm -f "$conf"
}

ghostty_reload() {
    # Reload config on any available Ghostty terminal
    osascript -e '
        tell application "Ghostty"
            if (count of windows) > 0 then
                perform action "reload_config" on terminal 1 of selected tab of first window
            end if
        end tell
    ' &>/dev/null || true
}

check_deps() {
    local missing=()
    command -v osascript &>/dev/null || missing+=("osascript (macOS)")
    command -v broot &>/dev/null || missing+=("broot")
    command -v bat &>/dev/null || missing+=("bat")
    command -v jq &>/dev/null || missing+=("jq")

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "idealize: missing dependencies: ${missing[*]}" >&2
        echo "  run 'idealyze doctor' to diagnose and fix" >&2
        exit 1
    fi

    if [[ ! -d "/Applications/Ghostty.app" ]]; then
        echo "idealize: Ghostty.app not found in /Applications" >&2
        echo "  run 'idealyze doctor' to diagnose and fix" >&2
        exit 1
    fi

    if ! command -v glow &>/dev/null; then
        echo "idealize: glow not found (optional — run 'idealyze doctor' to install)" >&2
    fi
}

doctor() {
    # Colors
    local B='\033[1m' D='\033[2m' G='\033[32m' Y='\033[33m' R='\033[31m' C='\033[36m' BL='\033[34m' N='\033[0m'
    [[ ! -t 1 ]] && B='' D='' G='' Y='' R='' C='' BL='' N=''

    local ok="${G}ok${N}" bad="${R}!!${N}" opt="${D}--${N}"
    local has_brew=false all_ok=true
    command -v brew &>/dev/null && has_brew=true

    echo -e "\n${B}${BL}idealize doctor${N}\n"

    # --- System ---
    echo -e "${B}System${N}"
    if [[ "$(uname -s)" == "Darwin" ]]; then
        echo -e "  ${ok}  macOS $(sw_vers -productVersion 2>/dev/null || echo '')"
    else
        echo -e "  ${bad}  not macOS — idealize requires macOS"
        all_ok=false
    fi

    if [[ -d "/Applications/Ghostty.app" ]]; then
        echo -e "  ${ok}  Ghostty"
    else
        echo -e "  ${bad}  Ghostty ${D}— download from https://ghostty.org${N}"
        all_ok=false
    fi

    # --- Required deps ---
    echo -e "\n${B}Required${N}"
    local missing_req=()
    for dep in jq broot bat; do
        if command -v "$dep" &>/dev/null; then
            local ver
            ver=$("$dep" --version 2>/dev/null | head -1 || echo "installed")
            echo -e "  ${ok}  ${dep} ${D}${ver}${N}"
        else
            echo -e "  ${bad}  ${dep}"
            missing_req+=("$dep")
            all_ok=false
        fi
    done

    # --- Optional deps ---
    echo -e "\n${B}Optional${N}"
    local missing_opt=()
    for dep in glow; do
        if command -v "$dep" &>/dev/null; then
            local ver
            ver=$("$dep" --version 2>/dev/null | head -1 || echo "installed")
            echo -e "  ${ok}  ${dep} ${D}${ver}${N}"
        else
            echo -e "  ${opt}  ${dep} ${D}(enables rendered markdown preview)${N}"
            missing_opt+=("$dep")
        fi
    done

    # --- Hooks ---
    echo -e "\n${B}Hooks${N}"
    PROVIDER=$(cfg "provider" "claude-code")
    if [[ -f "${LIB_DIR}/providers/${PROVIDER}.sh" ]]; then
        source "${LIB_DIR}/providers/${PROVIDER}.sh"
        if provider_is_installed; then
            echo -e "  ${ok}  $(provider_name) installed"
            if provider_check_hooks; then
                echo -e "  ${ok}  hooks configured"
            else
                echo -e "  ${bad}  hooks not configured"
                all_ok=false
            fi
        else
            echo -e "  ${opt}  $(provider_name) not installed"
        fi
    else
        echo -e "  ${bad}  provider '${PROVIDER}' not found"
        all_ok=false
    fi

    # --- Install ---
    echo -e "\n${B}Install${N}"
    if [[ -d "$IDEALYZE_HOME" ]]; then
        if [[ -f "${IDEALYZE_HOME}/.install-meta" ]]; then
            local mode
            mode=$(grep '^mode=' "${IDEALYZE_HOME}/.install-meta" | cut -d= -f2)
            echo -e "  ${ok}  installed (${mode} mode)"
        else
            echo -e "  ${ok}  installed ${D}(no metadata)${N}"
        fi
    else
        echo -e "  ${bad}  not installed"
        all_ok=false
    fi

    # --- Ghostty config ---
    echo -e "\n${B}Ghostty config${N}"
    local ghostty_conf="${HOME}/.config/ghostty/config"
    if [[ -f "$ghostty_conf" ]] && grep -q 'confirm-close-surface.*=.*false' "$ghostty_conf"; then
        echo -e "  ${ok}  confirm-close-surface = false"
    else
        echo -e "  ${opt}  confirm-close-surface not disabled ${D}(idealize will ask before closing panes)${N}"
        echo ""
        echo -en "  ${C}?${N} Disable close confirmation in Ghostty? ${D}[y/N]${N} "
        local reply=""
        read -r reply </dev/tty 2>/dev/null || read -r reply 2>/dev/null || reply=""
        if [[ "$reply" =~ ^[Yy] ]]; then
            ghostty_config_set "confirm-close-surface" "false"
            ghostty_reload
            echo -e "  ${ok}  confirm-close-surface = false ${D}(applied)${N}"
        fi
    fi

    # --- Autofix ---
    if [[ ${#missing_req[@]} -gt 0 && "$has_brew" == true ]]; then
        echo ""
        echo -en "  ${C}?${N} Install missing required deps via brew? (${missing_req[*]}) ${D}[Y/n]${N} "
        local reply
        read -r reply </dev/tty 2>/dev/null || read -r reply 2>/dev/null || reply=""
        reply="${reply:-y}"
        if [[ "$reply" =~ ^[Yy] ]]; then
            for dep in "${missing_req[@]}"; do
                echo -e "  ${C}>${N} installing ${B}${dep}${N}..."
                if brew install "$dep" 2>/dev/null; then
                    echo -e "  ${ok}  ${dep} installed"
                else
                    echo -e "  ${bad}  failed to install ${dep}"
                fi
            done
        fi
    fi

    if [[ ${#missing_opt[@]} -gt 0 && "$has_brew" == true ]]; then
        echo ""
        echo -en "  ${C}?${N} Install optional deps? (${missing_opt[*]}) ${D}[y/N]${N} "
        local reply
        read -r reply </dev/tty 2>/dev/null || read -r reply 2>/dev/null || reply=""
        reply="${reply:-n}"
        if [[ "$reply" =~ ^[Yy] ]]; then
            for dep in "${missing_opt[@]}"; do
                echo -e "  ${C}>${N} installing ${B}${dep}${N}..."
                if brew install "$dep" 2>/dev/null; then
                    echo -e "  ${ok}  ${dep} installed"
                else
                    echo -e "  ${bad}  failed to install ${dep}"
                fi
            done
        fi
    fi

    # --- Version check ---
    echo -e "\n${B}Version${N}"
    echo -e "  ${ok}  ${VERSION} (installed)"
    local channel
    channel=$(cfg "updates.channel" "latest")
    local remote_ver
    remote_ver=$(curl -fsSL --max-time "$(cfg_int updates.check_timeout 3)" "https://raw.githubusercontent.com/diananerd/idealize/${channel}/bin/idealyze" 2>/dev/null | grep '^VERSION=' | head -1 | cut -d'"' -f2)
    if [[ -n "$remote_ver" ]]; then
        if [[ "$remote_ver" != "$VERSION" ]]; then
            echo -e "  ${Y}!!${N}  ${remote_ver} available on ${channel} — run ${B}idealyze update${N}"
        else
            echo -e "  ${ok}  up to date (${channel})"
        fi
    fi

    # --- Summary ---
    echo ""
    if [[ "$all_ok" == true ]]; then
        echo -e "  ${G}${B}All good!${N}"
    else
        echo -e "  ${Y}Some issues found — fix them and run 'idealyze doctor' again${N}"
    fi
    echo ""
}

check_preflight() {
    local errors=()
    [[ "$(uname -s)" != "Darwin" ]] && errors+=("macOS required")
    [[ ! -d "/Applications/Ghostty.app" ]] && errors+=("Ghostty not found")
    command -v jq &>/dev/null || errors+=("jq not found")
    command -v broot &>/dev/null || errors+=("broot not found")
    command -v bat &>/dev/null || errors+=("bat not found")
    command -v osascript &>/dev/null || errors+=("osascript not found")
    command -v curl &>/dev/null || errors+=("curl not found")

    if [[ ${#errors[@]} -gt 0 ]]; then
        echo "idealize: preflight failed:" >&2
        for e in "${errors[@]}"; do echo "  - $e" >&2; done
        echo "  run 'idealyze doctor' to fix" >&2
        exit 1
    fi
}

launch() {
    local project_dir="${1:-$(pwd)}"

    # Check for existing session
    if [[ -f "$SESSION_FILE" ]]; then
        local win_id
        win_id=$(jq -r '.panes.window // empty' "$SESSION_FILE")
        if [[ -n "$win_id" ]] && [[ "$win_id" =~ ^[a-zA-Z0-9_.@-]+$ ]]; then
            if ! osascript -e "
                tell application \"Ghostty\"
                    first window whose id is \"${win_id}\"
                end tell
            " &>/dev/null; then
                echo "idealize: cleaning up stale session..."
                # Kill stale viewer-loop
                local vpid_file="${IDEALYZE_HOME}/viewer-loop.pid"
                if [[ -f "$vpid_file" ]]; then
                    local stale_vpid
                    stale_vpid=$(cat "$vpid_file" 2>/dev/null)
                    [[ -n "$stale_vpid" ]] && kill "$stale_vpid" 2>/dev/null
                    rm -f "$vpid_file"
                fi
                rm -f "$SESSION_FILE"
                rm -f "/tmp/broot-server-$(cfg broot_socket idealyze).sock"
            else
                echo "idealize: session already active. Run 'idealyze stop' first." >&2
                exit 1
            fi
        else
            rm -f "$SESSION_FILE"
        fi
    fi

    check_preflight

    echo "idealize: launching in ${project_dir}..."
    debug "launching in $project_dir"
    debug "LIB_DIR=$LIB_DIR CONFIG_DIR=$CONFIG_DIR"

    mkdir -p "$IDEALYZE_HOME"

    [[ "${IDEALYZE_DEBUG:-}" == "1" ]] && : > "$DEBUG_LOG"
    debug "=== new session $(date) ==="

    # Resolve agent command and config values
    local agent_cmd broot_socket shrink step
    agent_cmd="${IDEALYZE_AGENT_CMD:-$(cfg agent_cmd claude)}"
    broot_socket=$(cfg "broot_socket" "idealyze")

    if [[ -z "${IDEALYZE_WITH_AGENT:-}" ]]; then
        shrink=$(cfg_int "layout.tree_shrink_2pane" "30")
        agent_cmd="no-agent"
    else
        shrink=$(cfg_int "layout.tree_shrink_3pane" "13")
    fi
    step=$(cfg_int "layout.resize_step" "10")

    # Run AppleScript layout
    local pane_json
    debug "running layout.applescript..."
    local env_prefix=""
    [[ "${IDEALYZE_DEBUG:-}" == "1" ]] && env_prefix="IDEALYZE_DEBUG=1 "
    pane_json=$(osascript "${LIB_DIR}/layout.applescript" \
        "$project_dir" "$LIB_DIR" "${CONFIG_DIR}/broot-sidebar.toml" \
        "$agent_cmd" "$shrink" "$step" "$broot_socket" "$env_prefix") || { debug "layout.applescript FAILED"; echo "idealize: layout creation failed" >&2; exit 1; }
    debug "pane_json: $pane_json"

    # Build session.json
    local window_id viewer_id tree_id agent_id
    window_id=$(echo "$pane_json" | jq -r '.window_id')
    tree_id=$(echo "$pane_json" | jq -r '.tree_id')
    viewer_id=$(echo "$pane_json" | jq -r '.viewer_id')
    agent_id=$(echo "$pane_json" | jq -r '.agent_id')
    debug "IDs: window=$window_id tree=$tree_id viewer=$viewer_id agent=$agent_id"

    jq -n \
        --arg ver "$VERSION" \
        --argjson pid $$ \
        --arg pd "$project_dir" \
        --arg scope "${IDEALYZE_SCOPE:-project}" \
        --arg acmd "${agent_cmd}" \
        --arg bsock "$broot_socket" \
        --arg wid "$window_id" \
        --arg tid "$tree_id" \
        --arg vid "$viewer_id" \
        --arg aid "$agent_id" \
        '{
            version: $ver, pid: $pid, project_dir: $pd, scope: $scope,
            agent_cmd: $acmd, broot_socket: $bsock, viewer_mode: "raw",
            tree_visible: true, current_file: null, current_line: 1,
            panes: { window: $wid, tree: $tid, viewer: $vid, agent: $aid }
        }' > "$SESSION_FILE"

    echo "idealize: ready. Hooks will sync automatically."
}

stop_session() {
    if [[ ! -f "$SESSION_FILE" ]]; then
        echo "idealize: no active session" >&2
        exit 0
    fi

    local win_id
    win_id=$(jq -r '.panes.window // empty' "$SESSION_FILE")
    if [[ -n "$win_id" ]]; then
        debug "closing Ghostty window: $win_id"
        osascript -e "
            tell application \"Ghostty\"
                try
                    set w to first window whose id is \"${win_id}\"
                    perform action \"close_window\" on terminal 1 of selected tab of w
                end try
            end tell
        " >/dev/null 2>/dev/null || true
    fi

    # Kill viewer-loop if still running
    local vpid_file="${IDEALYZE_HOME}/viewer-loop.pid"
    if [[ -f "$vpid_file" ]]; then
        local vpid
        vpid=$(cat "$vpid_file" 2>/dev/null)
        if [[ -n "$vpid" ]] && kill -0 "$vpid" 2>/dev/null; then
            kill "$vpid" 2>/dev/null
            debug "killed viewer-loop pid=$vpid"
        fi
        rm -f "$vpid_file"
    fi

    rm -f "/tmp/broot-server-$(cfg broot_socket idealyze).sock"
    rm -f "$SESSION_FILE"

    echo "idealize: session closed"
}

uninstall() {
    local B='\033[1m' D='\033[2m' G='\033[32m' Y='\033[33m' R='\033[31m' C='\033[36m' N='\033[0m'
    [[ ! -t 1 ]] && B='' D='' G='' Y='' R='' C='' N=''
    local ok="${G}ok${N}" skip="${D}--${N}"

    local auto=false
    [[ "${1:-}" == "--yes" ]] && auto=true

    echo -e "\n${B}idealize uninstall${N}\n"

    # Detect install mode
    local install_mode="user"
    local bin_dir="${HOME}/.local/bin"
    local home_dir="$IDEALYZE_HOME"

    if [[ -d "$(pwd)/.idealyze" && -f "$(pwd)/.idealyze/.install-meta" ]]; then
        install_mode="project"
        home_dir="$(pwd)/.idealyze"
        bin_dir=$(grep '^bin_dir=' "$(pwd)/.idealyze/.install-meta" | cut -d= -f2)
    elif [[ -f "${IDEALYZE_HOME}/.install-meta" ]]; then
        install_mode=$(grep '^mode=' "${IDEALYZE_HOME}/.install-meta" | cut -d= -f2)
        bin_dir=$(grep '^bin_dir=' "${IDEALYZE_HOME}/.install-meta" | cut -d= -f2)
    fi

    echo -e "  ${D}install mode:${N} ${install_mode}"
    echo -e "  ${D}install dir:${N}  ${home_dir}"
    [[ -n "$bin_dir" ]] && echo -e "  ${D}binary:${N}       ${bin_dir}/idealyze"
    echo ""

    if [[ "$auto" != true ]]; then
        echo -en "  ${C}?${N} Remove idealize and all its configuration? ${D}[y/N]${N} "
        local confirm
        read -r confirm
        [[ "$confirm" =~ ^[Yy]$ ]] || { echo -e "\n  cancelled"; exit 0; }
        echo ""
    fi

    # --- Stop active session ---
    if [[ -f "${home_dir}/session.json" ]]; then
        echo -e "  ${C}>${N} stopping active session..."
        local win_id
        win_id=$(jq -r '.panes.window // empty' "${home_dir}/session.json" 2>/dev/null)
        if [[ -n "$win_id" ]]; then
            osascript -e "
                tell application \"Ghostty\"
                    try
                        set w to first window whose id is \"${win_id}\"
                        perform action \"close_window\" on terminal 1 of selected tab of w
                    end try
                end tell
            " &>/dev/null || true
        fi
        rm -f "/tmp/broot-server-$(cfg broot_socket idealyze).sock"
        echo -e "  ${ok}  session stopped"
    fi

    # --- Remove hooks ---
    PROVIDER=$(cfg "provider" "claude-code")
    if [[ -f "${LIB_DIR}/providers/${PROVIDER}.sh" ]]; then
        source "${LIB_DIR}/providers/${PROVIDER}.sh"
        provider_remove_hooks
        echo -e "  ${ok}  removed $(provider_name) hooks ${D}(backup: settings.json.bak)${N}"
    fi

    # --- Revert Ghostty config ---
    local ghostty_conf="${HOME}/.config/ghostty/config"
    if [[ -f "$ghostty_conf" ]] && grep -q 'confirm-close-surface' "$ghostty_conf"; then
        local revert_ghostty=false
        if [[ "$auto" == true ]]; then
            revert_ghostty=true
        else
            echo -en "  ${C}?${N} Restore Ghostty close confirmation? ${D}[Y/n]${N} "
            local reply
            read -r reply
            reply="${reply:-y}"
            [[ "$reply" =~ ^[Yy] ]] && revert_ghostty=true
        fi
        if [[ "$revert_ghostty" == true ]]; then
            ghostty_config_remove "confirm-close-surface"
            ghostty_reload
            echo -e "  ${ok}  restored Ghostty close confirmation"
        else
            echo -e "  ${skip}  kept Ghostty config as-is"
        fi
    fi

    # --- Remove install directory ---
    if [[ -d "$home_dir" ]]; then
        rm -rf "$home_dir"
        echo -e "  ${ok}  removed ${home_dir}"
    else
        echo -e "  ${skip}  ${home_dir} not found"
    fi

    # --- Remove binary ---
    if [[ -n "$bin_dir" && -f "${bin_dir}/idealyze" ]]; then
        rm -f "${bin_dir}/idealyze"
        echo -e "  ${ok}  removed ${bin_dir}/idealyze"
    fi

    echo -e "\n  ${G}${B}Uninstalled${N} ${D}(${install_mode} mode)${N}\n"
}

update() {
    local channel
    channel=$(cfg "updates.channel" "latest")

    echo "idealize: updating from ${channel} channel..."

    # Download and run install.sh with --auto to preserve current setup
    local install_url="https://raw.githubusercontent.com/diananerd/idealize/${channel}/install.sh"
    local install_script
    install_script=$(curl -fsSL "$install_url" 2>/dev/null) || {
        echo "idealize: failed to download installer" >&2
        exit 1
    }
    bash -c "$install_script" -- --auto ${channel:+--${channel}}
}

check_for_updates() {
    # Quick background check — compare local version with remote
    local channel
    channel=$(cfg "updates.channel" "latest")

    local remote_version
    remote_version=$(curl -fsSL --max-time "$(cfg_int updates.check_timeout 3)" "https://raw.githubusercontent.com/diananerd/idealize/${channel}/bin/idealyze" 2>/dev/null | grep '^VERSION=' | head -1 | cut -d'"' -f2)

    if [[ -n "$remote_version" && "$remote_version" != "$VERSION" ]]; then
        echo "idealize: update available (${VERSION} → ${remote_version}). Run 'idealyze update'" >&2
    fi
}

# --- Main ---

case "${1:-}" in
    --version|-v)
        echo "idealyze ${VERSION}"
        check_for_updates
        ;;
    --help|-h)
        usage
        ;;
    --hook)
        shift
        case "${1:-}" in
            post-tool-use)
                exec "${LIB_DIR}/hooks.sh"
                ;;
            *)
                exit 0
                ;;
        esac
        ;;
    toggle)
        shift
        exec "${LIB_DIR}/toggle.sh" "${1:-}"
        ;;
    doctor)
        doctor
        ;;
    update)
        update
        ;;
    stop)
        stop_session
        ;;
    uninstall)
        shift
        uninstall "${1:-}"
        ;;
    --global)
        IDEALYZE_SCOPE="global" launch
        ;;
    --with-agent)
        shift
        IDEALYZE_WITH_AGENT="1" IDEALYZE_AGENT_CMD="${1:-$(cfg agent_cmd claude)}" launch
        ;;
    "")
        launch
        ;;
    *)
        echo "idealize: unknown command '${1}'" >&2
        usage
        exit 1
        ;;
esac
